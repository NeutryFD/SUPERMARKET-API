SUPERMARKET_API_DATABASE_URL=mysql+pymysql://usuario:password@host:3306/supermarket_api?charset=utf8mb4
SUPERMARKET_API_CORS_ORIGINS=["https://tu-frontend.com","http://localhost:5173"]
SUPERMARKET_API_SCRAPE_TOKEN=replace-with-a-long-random-token
SUPERMARKET_API_POSTCODE=08001
SUPERMARKET_API_ENABLED_SUPERMARKETS=["mercadona","bonarea"]

# docker compose: dirección y puerto del host donde se publica la API
API_BIND=127.0.0.1
API_PORT=8100
